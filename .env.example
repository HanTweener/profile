# ==========================================
# Cloudflare Zero Trust Configuration
# ==========================================
# Tunnel token obtained from Cloudflare Zero Trust Dashboard
TUNNEL_TOKEN=eyJh...your_cloudflare_tunnel_token_here...

# ==========================================
# Docker & Deployment Configuration
# ==========================================
# Docker Image from GitHub Container Registry (GHCR)
DOCKER_IMAGE=ghcr.io/<your-github-username>/<your-repo-name>:latest

# Host port mapping (access locally at http://localhost:3000 or 80)
APP_PORT=3000

# ==========================================
# Frontend Configuration (Vite client-side)
# ==========================================
# Primary Site / Portfolio URL
VITE_SITE_URL=https://your-domain.com

# Contact & Profile Info
VITE_PROFILE_EMAIL=your.email@example.com
VITE_GITHUB_USERNAME=your-github-username
VITE_GITHUB_URL=https://github.com/your-github-username

# Project Live Showcase URLs
VITE_PROJECT_1_URL=https://project1.your-domain.com/
VITE_PROJECT_2_URL=https://project2.your-domain.com/
VITE_PROJECT_4_URL=https://project4.your-domain.com/
VITE_PROJECT_5_URL=https://project5.your-domain.com/
